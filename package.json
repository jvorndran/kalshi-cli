{
  "name": "@jvorndran/kalshi-cli",
  "version": "0.1.0",
  "description": "Agent-first, read-only CLI for Kalshi public market data",
  "author": "Jacob Vorndran",
  "type": "module",
  "bin": {
    "kalshi": "bin/kalshi.js"
  },
  "files": [
    "bin",
    "src",
    "skills/kalshi-cli",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check bin/kalshi.js && node --check src/args.js && node --check src/commands.js && node --check src/errors.js && node --check src/execute.js && node --check src/main.js && node --check src/request.js && node --check src/version.js && node --check scripts/check-release.js && npm test && npm run test:pack",
    "test": "node --test test/cli.test.js test/install.test.js",
    "test:live": "node --test test/live-smoke.test.js",
    "test:pack": "node --test test/pack.test.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/check-release.js",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvorndran/kalshi-cli.git"
  },
  "homepage": "https://github.com/jvorndran/kalshi-cli#readme",
  "bugs": {
    "url": "https://github.com/jvorndran/kalshi-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "kalshi",
    "prediction-markets",
    "market-data",
    "cli",
    "agent",
    "agent-tools"
  ]
}
